# ==============================================================================
# JEEP BALURAN - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Petunjuk:
# Salin file ini menjadi .env.local untuk pengembangan lokal,
# atau masukkan variabel berikut ke Dashboard Vercel > Settings > Environment Variables.
# ==============================================================================

# [OPSIONAL] Google Analytics 4 Measurement ID
# Jika diisi, website akan mulai merekam event: click_whatsapp, click_map, view_faq, view_package.
# Jika dikosongkan, website tetap berjalan normal tanpa error (safe no-op).
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
